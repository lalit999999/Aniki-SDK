# Copy this file to .env and fill in your own values.
#
# `npm run smoke` loads this file automatically via Node's built-in
# `--env-file-if-exists` flag (Node >= 20.12). On Node 18/19 or Node
# 20.0-20.11, that flag doesn't exist yet — export the variables below in
# your shell instead and run `node index.js` directly.

# Required to run the live section of the smoke harness (npm run smoke).
# Leave unset to exercise only the offline MockProvider path
# (npm run smoke:offline), which needs no credentials.
OPENAI_API_KEY=

# Optional. Overrides the OpenAI-compatible base URL the live section talks
# to. Defaults to OpenAI's own API when unset.
#
# OpenRouter's correct base is https://openrouter.ai/api/v1 — note the
# /api segment. https://openrouter.ai/v1 (missing /api) 404s; that
# misconfiguration is the original bug this harness exists to catch.
ANIKI_BASE_URL=

# Optional. Model id sent to the configured provider. Defaults to
# gpt-4o-mini.
ANIKI_MODEL=
